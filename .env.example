# --- Supabase ---
# For LOCAL dev, run `npm run db:start` and copy the printed API URL + keys here
# (into .env.local). For CLOUD, copy from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Used to build absolute links (e.g. secure invoice URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WhatsApp (V1 deep-link) ---
# Nursery business WhatsApp number in international format, digits only.
# Example for India: 9198XXXXXXXX  (91 = country code, no +, spaces, or dashes)
NURSERY_WHATSAPP_NUMBER=
